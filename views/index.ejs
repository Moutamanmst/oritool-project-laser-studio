<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary Meta Tags -->
    <title><%= seo.title %></title>
    <meta name="title" content="<%= seo.title %>">
    <meta name="description" content="<%= seo.description %>">
    <% if (seo.keywords) { %>
    <meta name="keywords" content="<%= seo.keywords %>">
    <% } %>
    <meta name="robots" content="<%= seo.robots %>">
    <meta name="author" content="<%= seo.siteName %>">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="<%= seo.canonical %>">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="<%= seo.ogType %>">
    <meta property="og:url" content="<%= seo.ogUrl %>">
    <meta property="og:title" content="<%= seo.ogTitle %>">
    <meta property="og:description" content="<%= seo.ogDescription %>">
    <meta property="og:image" content="<%= seo.ogImage %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="<%= seo.siteName %>">
    <meta property="og:locale" content="<%= seo.locale %>">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= seo.ogUrl %>">
    <meta name="twitter:title" content="<%= seo.ogTitle %>">
    <meta name="twitter:description" content="<%= seo.ogDescription %>">
    <meta name="twitter:image" content="<%= seo.ogImage %>">
    <% if (seo.twitterHandle) { %>
    <meta name="twitter:site" content="<%= seo.twitterHandle %>">
    <% } %>
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#8B7A73">
    <meta name="format-detection" content="telephone=yes">
    <meta name="geo.region" content="UA-05">
    <meta name="geo.placename" content="Вінниця">
    <meta name="geo.position" content="49.2331;28.4682">
    <meta name="ICBM" content="49.2331, 28.4682">
    
    <!-- Structured Data (JSON-LD) -->
    <% schemas.forEach(function(schema) { %>
    <script type="application/ld+json"><%- JSON.stringify(schema) %></script>
    <% }); %>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Dancing+Script:wght@400;600;700&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600&family=Pinyon+Script&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Styles -->
    <link rel="stylesheet" href="style.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="schedule.css">
    <link rel="stylesheet" href="services-add.css">
    
    <style>
        .hero::before {
            background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('<%= content.hero.image.startsWith("http") || content.hero.image.startsWith("/") ? content.hero.image : "/" + content.hero.image %>') no-repeat center center/cover !important;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="header" role="banner">
        <div class="container">
            <nav class="nav" role="navigation" aria-label="Головна навігація">
                <a href="/" class="logo" aria-label="<%= seo.siteName %> - На головну">
                    <span class="logo-text">Laser Studio</span>
                    <span class="logo-name">Rymarchuk</span>
                </a>
                <ul class="nav-menu" id="navMenu">
                    <li><a href="/" class="nav-link active" aria-current="page">Головна</a></li>
                    <li><a href="/price" class="nav-link">Послуги</a></li>
                    <li><a href="/results" class="nav-link">Результати</a></li>
                    <li><a href="/blog" class="nav-link">Блог</a></li>
                    <li><a href="#contacts" class="nav-link">Контакти</a></li>
                    <li class="mobile-only"><a href="tel:<%= content.site.phoneLink %>" class="nav-link">📞 Зателефонувати</a></li>
                </ul>
                <button class="btn btn-primary" aria-label="Записатись на процедуру">ЗАПИСАТИСЬ</button>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Відкрити меню" aria-expanded="false">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero" role="banner" aria-label="Головний банер">
        <div class="hero-content">
            <h1 class="hero-title"><%- content.hero.title %></h1>
            <p class="hero-subtitle"><%- content.hero.subtitle %></p>

            <% if (content.hero.showPromo) { %>
            <div class="hero-promo" role="alert" aria-label="Акція">
                <div class="promo-content">
                    <span class="promo-text"><%- content.hero.promo %></span>
                </div>
            </div>
            <% } %>

            <p class="hero-tagline">ТОП-майстер з досвідом 9+ років</p>

            <button class="btn btn-accent" aria-label="Записатись онлайн на процедуру">ЗАПИСАТИСЬ ОНЛАЙН</button>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="section services" aria-labelledby="services-title">
        <div class="container">
            <header class="section-header">
                <h2 id="services-title" class="section-title">Наші Послуги</h2>
                <p class="section-subtitle">Ідеальна гладкість для кожної зони</p>
            </header>

            <div class="services-grid" role="list">
                <% content.services.forEach(function(item, index) { %>
                <article class="service-card" role="listitem">
                    <img src="<%= item.image.startsWith('http') || item.image.startsWith('/') ? item.image : '/' + item.image %>"
                        alt="<%= item.alt || item.title + ' - послуга лазерної епіляції у Вінниці' %>" 
                        class="service-image"
                        loading="<%= index < 3 ? 'eager' : 'lazy' %>"
                        width="400" height="300">
                    <div class="service-details">
                        <h3 class="service-title"><%- item.title %></h3>
                        <p class="service-description"><%- item.description %></p>
                        <div class="service-price-row">
                            <p class="service-price"><%- item.price %></p>
                            <button class="btn-add-service" 
                                onclick="openBookingModal('<%= item.title %>')"
                                title="Записатись на <%= item.title %>"
                                aria-label="Записатись на послугу <%= item.title %>">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </article>
                <% }); %>
            </div>

            <div class="text-center" style="margin-top: 60px;">
                <a href="/price" class="btn btn-primary">ПЕРЕГЛЯНУТИ ПРАЙС</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section about" aria-labelledby="about-title">
        <div class="container">
            <div class="about-content">
                <div class="about-image-wrapper">
                    <img src="<%= content.about.image.startsWith('http') || content.about.image.startsWith('/') ? content.about.image : '/' + content.about.image %>"
                        alt="Анна Римарчук - ТОП-майстер лазерної епіляції у Вінниці з досвідом 9+ років" 
                        class="about-image"
                        loading="lazy">
                </div>

                <div class="about-right">
                    <span class="about-subtitle"><%= content.about.subtitle %></span>
                    <h2 id="about-title" class="about-title"><%- content.about.title %></h2>
                    <p class="about-text"><%- content.about.text1 %></p>
                    <p class="about-text"><%- content.about.text2 %></p>

                    <ul class="about-checklist" role="list" aria-label="Переваги">
                        <% content.about.checklist.forEach(function(item) { %>
                        <li>
                            <span class="check-icon" aria-hidden="true">✓</span>
                            <span class="check-text"><%= item %></span>
                        </li>
                        <% }); %>
                    </ul>

                    <div style="margin-top: 40px;">
                        <img src="signature.png" alt="Підпис Анни Римарчук" style="height: 60px; opacity: 0.6; display: none;">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="section portfolio" aria-labelledby="portfolio-title">
        <div class="container">
            <header class="section-header">
                <h2 id="portfolio-title" class="section-title">Наші роботи</h2>
                <p class="section-subtitle">Результати, які говорять самі за себе</p>
            </header>
            <div class="portfolio-grid" role="list">
                <% content.portfolio.forEach(function(item, index) { %>
                <figure class="portfolio-item" role="listitem">
                    <img src="<%= item.image.startsWith('http') || item.image.startsWith('/') ? item.image : '/' + item.image %>"
                        alt="<%= item.alt || item.title + ' - результат лазерної епіляції' %>"
                        loading="lazy"
                        width="400" height="400">
                    <figcaption class="portfolio-overlay">
                        <span><%- item.title %></span>
                    </figcaption>
                </figure>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Schedule Section -->
    <section id="schedule" class="section schedule-premium" aria-labelledby="schedule-title">
        <div class="schedule-bg" aria-hidden="true"></div>
        <div class="container">
            <div class="schedule-content-box">
                <span class="schedule-subtitle">Ми чекаємо на вас</span>
                <h2 id="schedule-title" class="schedule-title">Графік Роботи</h2>

                <div class="schedule-line" aria-hidden="true"></div>

                <div class="schedule-hours">
                    <div class="hours-icon" aria-hidden="true"><i class="far fa-clock"></i></div>
                    <time class="hours-text"><%- content.site.schedule %></time>
                </div>

                <div class="schedule-cta">
                    <p>Запишіться прямо зараз</p>
                    <a href="tel:<%= content.site.phoneLink %>" class="btn-premium-outline" aria-label="Зателефонувати <%= content.site.phone %>">
                        <span><%- content.site.phone %></span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom Cards (Advantages) -->
    <section class="bottom-cards" aria-labelledby="advantages-title">
        <div class="container">
            <h2 id="advantages-title" class="visually-hidden">Наші переваги</h2>
            <div class="cards-grid" role="list">
                <article class="info-card" role="listitem">
                    <div class="card-icon" aria-hidden="true">🛡️</div>
                    <h3 class="card-title">Безпека</h3>
                    <p class="card-description">Стерильність та одноразові матеріали для кожного клієнта.</p>
                </article>
                <article class="info-card" role="listitem">
                    <div class="card-icon" aria-hidden="true">💎</div>
                    <h3 class="card-title">Якість</h3>
                    <p class="card-description">Потужний діодний лазер 3000 Вт для найкращих результатів.</p>
                </article>
                <article class="info-card" role="listitem">
                    <div class="card-icon" aria-hidden="true">🎓</div>
                    <h3 class="card-title">Досвід</h3>
                    <p class="card-description">9+ років практики та тисячі задоволених клієнтів.</p>
                </article>
                <article class="info-card" role="listitem">
                    <div class="card-icon" aria-hidden="true">💖</div>
                    <h3 class="card-title">Турбота</h3>
                    <p class="card-description">Індивідуальний підхід та комфорт під час процедури.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contacts" class="footer" role="contentinfo">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-column">
                    <h3>Rymarchuk</h3>
                    <p class="footer-text"><%- content.site.footerText %></p>
                </div>

                <div class="footer-column">
                    <h3>Контакти</h3>
                    <address class="footer-contact">
                        <p>📍 м. Вінниця, вул. Соборна, 41</p>
                        <p>📞 <a href="tel:<%= content.site.phoneLink %>" style="color: inherit; text-decoration: none;"><%- content.site.phone %></a></p>
                    </address>
                </div>
                <div class="footer-column">
                    <h3>Соцмережі</h3>
                    <div class="social-links">
                        <a href="<%= content.site.instagram %>" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Наш Instagram">
                            <i class="fab fa-instagram" aria-hidden="true"></i>
                        </a>
                        <a href="viber://add?number=<%= content.site.phoneLink %>" target="_blank" class="social-link" aria-label="Написати у Viber">
                            <i class="fab fa-viber" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; <%= new Date().getFullYear() %> Laser Studio. Всі права захищено.</p>
            </div>
        </div>
    </footer>

    <!-- Booking Modal -->
    <div id="bookingModal" class="modal" role="dialog" aria-labelledby="booking-modal-title" aria-modal="true">
        <div class="modal-content">
            <button class="close-modal" onclick="document.getElementById('bookingModal').classList.remove('active'); document.body.style.overflow = '';" aria-label="Закрити вікно">&times;</button>
            <h2 id="booking-modal-title" class="modal-title"><%- content.booking.title %></h2>
            <p class="modal-subtitle"><%- content.booking.subtitle %></p>

            <form class="booking-form" id="bookingForm" aria-label="Форма запису на процедуру">
                <div class="form-group">
                    <label for="name">Ваше ім'я</label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">👤</span>
                        <input type="text" id="name" name="name" placeholder="Ваше ім'я" required autocomplete="name">
                    </div>
                </div>
                <div class="form-group">
                    <label for="phone">Номер телефону</label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">📞</span>
                        <input type="tel" id="phone" name="phone" placeholder="+380 XX XXX XX XX" required autocomplete="tel">
                    </div>
                </div>
                <div class="form-group">
                    <label for="service">Бажана процедура</label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">✨</span>
                        <select name="service" id="service" required>
                            <option value="" disabled selected>Оберіть послугу...</option>
                            <% content.services.forEach(function(item) { %>
                            <option value="<%= item.title %>"><%= item.title %></option>
                            <% }); %>
                            <option value="Консультація">Консультація</option>
                            <option value="Інше">Інше</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">ЗАПИСАТИСЬ</button>
                <p class="form-note"><%- content.booking.note %></p>
            </form>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="successModal" class="modal" role="dialog" aria-labelledby="success-modal-title" aria-modal="true">
        <div class="modal-content" style="text-align: center; padding: 50px 30px; border-radius: 12px; max-width: 450px;">
            <button class="close-modal" onclick="window.location.href='/'" aria-label="Закрити та повернутись на головну">&times;</button>
            <div style="font-size: 60px; color: #8B7A73; margin-bottom: 25px; animation: fadeInScale 0.5s ease;" aria-hidden="true">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2 id="success-modal-title" class="modal-title" style="font-family: 'Cormorant Garamond', serif; font-size: 32px; margin-bottom: 10px; color: #2C2C2C;">
                Заявку прийнято!</h2>
            <p class="modal-subtitle" style="font-family: 'Montserrat', sans-serif; font-size: 16px; color: #6B5B5B; margin-bottom: 30px; line-height: 1.6;">
                Дякуємо, що обрали нас. <br>
                Ми зв'яжемося з вами найближчим часом для підтвердження деталей.
            </p>
            <button class="btn btn-primary" style="padding: 12px 40px; font-size: 14px; letter-spacing: 1px; text-transform: uppercase;" onclick="window.location.href='/'">Чудово</button>
        </div>
    </div>

    <!-- Floating Contact Widget -->
    <div class="floating-widget" role="complementary" aria-label="Швидкі контакти">
        <a href="tel:+380632777543" class="widget-btn phone-btn" aria-label="Зателефонувати нам">
            <i class="fas fa-phone-alt" aria-hidden="true"></i>
        </a>
        <a href="https://www.instagram.com/anna_depilation_vn/" target="_blank" rel="noopener noreferrer" class="widget-btn insta-btn" aria-label="Відкрити наш Instagram">
            <i class="fab fa-instagram" aria-hidden="true"></i>
        </a>
    </div>

    <script src="script.js"></script>
    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const navMenu = document.getElementById('navMenu');
        
        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', function() {
                this.classList.toggle('active');
                navMenu.classList.toggle('active');
                this.setAttribute('aria-expanded', navMenu.classList.contains('active'));
                document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
            });
            
            // Close menu when clicking on a link
            navMenu.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenuBtn.classList.remove('active');
                    navMenu.classList.remove('active');
                    document.body.style.overflow = '';
                });
            });
        }
        
        function openBookingModal(serviceName) {
            const modal = document.getElementById('bookingModal');
            const serviceSelect = document.getElementById('service');

            if (serviceName) {
                let optionExists = false;
                for (let i = 0; i < serviceSelect.options.length; i++) {
                    if (serviceSelect.options[i].value === serviceName) {
                        serviceSelect.selectedIndex = i;
                        optionExists = true;
                        break;
                    }
                }
                if (!optionExists) {
                    serviceSelect.value = serviceName;
                }
            } else {
                serviceSelect.selectedIndex = 0;
            }

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // Focus management for accessibility
            setTimeout(() => {
                document.getElementById('name').focus();
            }, 100);
        }

        document.getElementById('bookingForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const formData = {
                name: this.name.value,
                phone: this.phone.value,
                service: this.service.value
            };

            fetch('/api/book', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData),
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('bookingModal').classList.remove('active');
                        document.body.style.overflow = '';
                        const successModal = document.getElementById('successModal');
                        successModal.classList.add('active');
                        this.reset();
                    } else {
                        alert('Сталася помилка. Спробуйте ще раз або зателефонуйте нам.');
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    alert('Сталася помилка. Спробуйте ще раз.');
                });
        });
        
        // Keyboard accessibility for modals
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(modal => {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }
        });
    </script>
</body>

</html>
