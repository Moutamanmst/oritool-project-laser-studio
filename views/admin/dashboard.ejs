        function addPriceCategory() {
            const container = document.getElementById('pricesContainer');
            const catIndex = container.children.length;
            const div = document.createElement('div');
            div.className = 'admin-section price-category-card';
            div.id = `cat-${catIndex}`;
            div.innerHTML = `
                <div class="form-group" style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="flex-grow: 1; margin-right: 10px;">
                        <label>Назва категорії</label>
                        <input type="text" name="prices[${catIndex}][category]" placeholder="Назва категорії">
                    </div>
                    <button type="button" class="delete-btn" onclick="this.closest('.price-category-card').remove()" style="margin-top: 24px; margin-left: 10px;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                <h4>Послуги в категорії</h4>
                <div class="price-items-list"></div>
                <button type="button" class="add-btn small" onclick="addPriceItem(this, ${catIndex})">
                    <i class="fas fa-plus"></i> Додати послугу
                </button>
            `;
            container.appendChild(div);
        }

        function uploadImage(input, hiddenInputId, previewId) {
            if (input.files && input.files[0]) {
                currentInput = input;
                currentHiddenInputId = hiddenInputId;
                currentPreviewId = previewId;

                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('cropImage').src = e.target.result;
                    document.getElementById('cropModal').style.display = 'flex';

                    if (cropper) {
                        cropper.destroy();
                    }

                    const image = document.getElementById('cropImage');
                    cropper = new Cropper(image, {
                        viewMode: 1,
                        autoCropArea: 1,
                        responsive: true,
                    });
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function closeCropModal() {
            document.getElementById('cropModal').style.display = 'none';
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
            if (currentInput) {
                currentInput.value = ''; // Clear input
            }
        }

        function saveCrop() {
            if (!cropper) return;

            cropper.getCroppedCanvas().toBlob((blob) => {
                const formData = new FormData();
                formData.append('image', blob, 'cropped.jpg');

                fetch('/admin/upload', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update hidden input
                            if (typeof currentHiddenInputId === 'string') {
                                document.getElementById(currentHiddenInputId).value = data.filepath;
                            } else {
                                currentHiddenInputId.value = data.filepath;
                            }

                            // Update preview
                            if (typeof currentPreviewId === 'string') {
                                const preview = document.getElementById(currentPreviewId);
                                preview.src = '/' + data.filepath;
                                preview.classList.add('show');
                            } else {
                                currentPreviewId.src = '/' + data.filepath;
                                currentPreviewId.classList.add('show');
                            }

                            closeCropModal();
                        } else {
                            alert('Помилка завантаження');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Помилка з\'єднання');
                    });
            }, 'image/jpeg', 0.9);
        }

        function addPortfolioItem() {
            const list = document.getElementById('portfolioList');
            const index = list.children.length;
            const div = document.createElement('div');
            div.className = 'portfolio-item-card';
            div.innerHTML = `
                <button type="button" class="delete-btn" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
                <div class="form-group">
                    <label>Фото</label>
                    <input type="hidden" name="portfolio[${index}][image]" class="portfolio-image-input" value="">
                    <div class="image-preview-container">
                        <img src="" class="image-preview portfolio-preview">
                    </div>
                    <div class="upload-btn-wrapper">
                        <button class="btn-upload" type="button">Завантажити</button>
                        <input type="file" onchange="uploadImage(this, this.parentElement.previousElementSibling.previousElementSibling, this.parentElement.previousElementSibling.querySelector('img'))">
                    </div>
                </div>
                <div class="form-group">
                    <label>Підпис</label>
                    <input type="text" name="portfolio[${index}][title]" id="portfolioTitle${index}" value="Нова робота">
                </div>
            `;
            list.appendChild(div);
        }

        function addServiceItem() {
            const list = document.getElementById('servicesList');
            const index = list.children.length;
            const div = document.createElement('div');
            div.className = 'portfolio-item-card service-item-card';
            div.innerHTML = `
                <button type="button" class="delete-btn" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
                <div class="form-group">
                    <label>Фото</label>
                    <input type="hidden" name="services[${index}][image]" class="service-image-input" value="">
                    <div class="image-preview-container">
                        <img src="" class="image-preview service-preview">
                    </div>
                    <div class="upload-btn-wrapper">
                        <button class="btn-upload" type="button">Завантажити</button>
                        <input type="file" onchange="uploadImage(this, this.parentElement.previousElementSibling.previousElementSibling, this.parentElement.previousElementSibling.querySelector('img'))">
                    </div>
                </div>
                <div class="form-group">
                    <label>Назва</label>
                    <input type="text" name="services[${index}][title]" id="serviceTitle${index}" value="Нова послуга">
                </div>
                <div class="form-group">
                    <label>Опис</label>
                    <textarea name="services[${index}][description]" id="serviceDesc${index}"></textarea>
                </div>
                <div class="form-group">
                    <label>Ціна</label>
                    <input type="text" name="services[${index}][price]" value="від 0 грн">
