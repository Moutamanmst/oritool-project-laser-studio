            `;
            list.appendChild(div);
        }
        
        function addBlogPost() {
            const list = document.getElementById('blogPostsList');
            // Remove "no posts" message if exists
            const emptyMsg = list.querySelector('p');
            if (emptyMsg) emptyMsg.remove();
            
            const index = list.querySelectorAll('.blog-post-card').length;
            const today = new Date().toISOString().split('T')[0];
            const slug = 'new-post-' + Date.now();
            
            const div = document.createElement('div');
            div.className = 'blog-post-card admin-card';
            div.id = 'blog-post-' + index;
            div.innerHTML = `
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <span class="post-category-badge" style="background: var(--color-accent); color: white; padding: 4px 10px; border-radius: 12px; font-size: 11px; text-transform: uppercase;">Нова</span>
                        <h4 style="margin-top: 10px; font-size: 18px;">Нова стаття</h4>
                    </div>
                    <button type="button" class="delete-btn" onclick="this.closest('.blog-post-card').remove()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="form-group">
                    <label>ID статті (URL slug)</label>
                    <input type="text" name="blog[posts][${index}][id]" value="${slug}" placeholder="my-article-slug">
                </div>
                
                <div class="form-group">
                    <label>Заголовок</label>
                    <input type="text" name="blog[posts][${index}][title]" value="Нова стаття" placeholder="Заголовок статті">
                </div>
                
                <div class="form-group">
                    <label>Короткий опис (excerpt)</label>
                    <textarea name="blog[posts][${index}][excerpt]" rows="2" placeholder="Короткий опис для картки статті..."></textarea>
                </div>
                
                <div class="form-group">
                    <label>Зображення</label>
                    <input type="hidden" name="blog[posts][${index}][image]" class="blog-image-input" value="service_1.jpg">
                    <div class="image-preview-container" style="width: 200px; height: 120px;">
                        <img src="/service_1.jpg" class="image-preview show blog-preview" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div class="upload-btn-wrapper">
                        <button class="btn-upload" type="button">Завантажити</button>
                        <input type="file" onchange="uploadImage(this, this.closest('.form-group').querySelector('.blog-image-input'), this.closest('.form-group').querySelector('.blog-preview'))">
                    </div>
