        document.getElementById('contentForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            // Re-index portfolio items
            const portfolioInputs = document.querySelectorAll('.portfolio-item-card:not(.service-item-card)');
            portfolioInputs.forEach((card, index) => {
                card.querySelector('.portfolio-image-input').name = `portfolio[${index}][image]`;
                card.querySelector('input[type="text"]').name = `portfolio[${index}][title]`;
            });

            // Re-index services items
            const serviceInputs = document.querySelectorAll('.service-item-card');
            serviceInputs.forEach((card, index) => {
                card.querySelector('.service-image-input').name = `services[${index}][image]`;
                card.querySelector('input[name*="[title]"]').name = `services[${index}][title]`;
                card.querySelector('textarea').name = `services[${index}][description]`;
                card.querySelector('input[name*="[price]"]').name = `services[${index}][price]`;
            });
            
            // Re-index blog posts
            const blogPosts = document.querySelectorAll('.blog-post-card');
            blogPosts.forEach((card, index) => {
                card.querySelectorAll('input, textarea').forEach(input => {
                    if (input.name && input.name.includes('blog[posts]')) {
                        input.name = input.name.replace(/blog\[posts\]\[\d+\]/, `blog[posts][${index}]`);
                    }
                });
            });

            const formData = new FormData(e.target);
            const data = {};

            // Helper to set nested values
            for (let [key, value] of formData.entries()) {
                // Handle array notation: portfolio[0][image]
                if (key.includes('[')) {
                    const parts = key.split('[').map(k => k.replace(']', ''));
                    let current = data;
                    for (let i = 0; i < parts.length - 1; i++) {
                        const part = parts[i];
                        if (!current[part]) current[part] = isNaN(parts[i + 1]) ? {} : [];
                        current = current[part];
                    }
                    current[parts[parts.length - 1]] = value;
                } else {
                    data[key] = value;
                }
            }

            // Explicitly handle showPromo checkbox because unchecked checkboxes are not included in FormData
            const showPromoCheckbox = document.querySelector('input[name="hero[showPromo]"]');
            if (showPromoCheckbox) {
                if (!data.hero) data.hero = {};
                data.hero.showPromo = showPromoCheckbox.checked;
            }

            try {
                const response = await fetch('/admin/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const msg = document.getElementById('successMessage');
                    msg.classList.add('show');
                    setTimeout(() => msg.classList.remove('show'), 3000);
                } else {
                    alert('Помилка при збереженні');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Помилка з\'єднання');
            }
        });

        // ==========================================
        // NOTIFICATION & AUTO-UPDATE LOGIC
        // ==========================================

        let lastAppointmentCount = <%= appointments ?appointments.length: 0 %>;

        function playNotificationSound() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;

            const audioContext = new AudioContext();

            // Try to resume if suspended
            if (audioContext.state === 'suspended') {
                audioContext.resume();
            }

            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(500, audioContext.currentTime);
            oscillator.frequency.exponentialRampToValueAtTime(1000, audioContext.currentTime + 0.1);

            gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);

            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);

            oscillator.start();
            oscillator.stop(audioContext.currentTime + 0.5);
        }

        // Web Worker for Background Polling
        let worker;
        let lastWorkerTick = Date.now();

        try {
            worker = new Worker('/worker.js');
            worker.onmessage = function (e) {
                if (e.data === 'tick') {
                    lastWorkerTick = Date.now();
                    logDebug('Worker tick');
                    checkNewAppointments();
                }
            };
            worker.postMessage('start');
            logDebug('Worker started');
        } catch (e) {
            logDebug('Worker failed: ' + e.message);
        }

        // Fallback Polling (if worker dies)
        setInterval(() => {
            if (Date.now() - lastWorkerTick > 7000) {
                logDebug('Fallback tick (Worker silent)');
                checkNewAppointments();
            }
        }, 5000);

        // Unlock Audio Context
        document.addEventListener('click', function () {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (AudioContext) {
                const ctx = new AudioContext();
                ctx.resume().then(() => {
                    logDebug('Audio Context Unlocked');
                });
            }
        }, { once: true });

        function checkNewAppointments() {
            const statusEl = document.getElementById('pollingStatus');
            const timeStr = new Date().toLocaleTimeString();

            // Fetch appointment count and then update status for debugging
            fetch('/api/appointments/count?t=' + Date.now())
                .then(response => response.json())
                .then(data => {
                    // Update status with counts for debugging
                    if (statusEl) {
                        statusEl.innerHTML = `Оновлено: ${new Date().toLocaleTimeString()} (S:${data.count} / L:${lastAppointmentCount}) <span style="color: #4CAF50;">●</span>`;
                    }
                    logDebug(`Check: Server=${data.count}, Local=${lastAppointmentCount}`);

                    if (data.count !== lastAppointmentCount) {
                        logDebug('CHANGE DETECTED!');

                        if (data.count > lastAppointmentCount) {
                            logDebug('New appointment! Playing sound.');
                            playNotificationSound();

                            const originalTitle = document.title;
                            document.title = '🔔 НОВИЙ ЗАПИС! | ' + originalTitle;
                            setTimeout(() => document.title = originalTitle, 5000);

                            const msg = document.getElementById('successMessage');
                            if (msg) {
                                msg.innerHTML = '<i class="fas fa-bell"></i> Новий запис клієнта!';
                                msg.classList.add('show');
                                setTimeout(() => msg.classList.remove('show'), 5000);
                            }
                        }

                        fetch('/api/appointments?t=' + Date.now())
                            .then(res => res.json())
                            .then(appointments => {
                                logDebug(`Table updated. New count: ${appointments.length}`);
                                updateTable(appointments);
                                lastAppointmentCount = appointments.length;
                            });
                    }
                })
                .catch(err => {
                    logDebug('Error: ' + err.message);
                    if (statusEl) statusEl.innerHTML = 'Помилка <span style="color: red;">●</span>';
                });
        }



        function playNotificationSound() {
            // Відтворюємо два короткі сигнали (біпи) за допомогою Web Audio API
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;

            function beep() {
                const ctx = new AudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, ctx.currentTime); // нота A4
                gain.gain.setValueAtTime(0.1, ctx.currentTime);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.15); // тривалість 150 мс
            }

            // Перший біп
            beep();
            // Другий біп через 200 мс
            setTimeout(beep, 200);
        }


        let appointmentToDeleteId = null;

        function deleteAppointment(id) {
            appointmentToDeleteId = id;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
            appointmentToDeleteId = null;
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!appointmentToDeleteId) return;

            const idToDelete = appointmentToDeleteId; // Store for DOM removal

            fetch('/api/appointments/' + idToDelete, {
                method: 'DELETE'
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        closeDeleteModal();

                        // 1. Remove from DOM immediately (Instant feedback)
                        const row = document.getElementById('appointment-row-' + idToDelete);
                        if (row) {
                            row.remove();
                        }

                        // Show success toast
                        const msg = document.getElementById('successMessage');
                        msg.innerHTML = '<i class="fas fa-check-circle"></i> Запис видалено!';
                        msg.classList.add('show');
                        setTimeout(() => msg.classList.remove('show'), 3000);

                        // 2. Background refresh to stay in sync
                        fetch('/api/appointments')
                            .then(res => res.json())
                            .then(appointments => {
                                // Only update if we didn't just break the table logic
                                // Actually, if we removed the row, we might be fine.
                                // But let's updateTable just in case of other changes
                                // updateTable(appointments); 
                                // Optimization: Don't redraw entire table if we just removed one row.
                                // Just update the count.
                                lastAppointmentCount = appointments.length;
                            });
                    } else {
                        alert('Помилка видалення');
                    }
                })
                .catch(err => alert('Помилка: ' + err));
        });

        function updateTable(appointments) {
            const tbody = document.querySelector('.appointments-table tbody');
            tbody.innerHTML = ''; // Clear current

            const reversedApps = [...appointments]; // Already sorted by unshift in server

            if (reversedApps.length > 0) {
                reversedApps.forEach(app => {
                    const row = `
                        <tr id="appointment-row-${app.id}" style="border-bottom: 1px solid #eee;">
                            <td style="padding: 12px;">${app.date}</td>
                            <td style="padding: 12px; font-weight: bold;">${app.name}</td>
                            <td style="padding: 12px;"><a href="tel:${app.phone}">${app.phone}</a></td>
                            <td style="padding: 12px;">${app.service}</td>
                            <td style="padding: 12px;">
                                <span class="status-badge ${app.status}"
                                    style="padding: 4px 8px; border-radius: 4px; background: #e3f2fd; color: #1976d2; font-size: 0.9em;">
                                    ${app.status === 'new' ? 'Новий' : app.status}
                                </span>
                            </td>
                            <td style="padding: 12px;">
                                <button class="btn-delete" title="Видалити" onclick="deleteAppointment('${app.id}')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', row);
                });
            } else {
                const noAppointmentsRow = `
                    <tr id="no-appointments-row">
                        <td colspan="6" style="padding: 20px; text-align: center; color: #666;">
                            Поки що немає записів
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', noAppointmentsRow);
            }
        }
    </script>
