                        </thead>
                        <tbody>
                            <% if (appointments && appointments.length> 0) { %>
                                <% appointments.forEach(function(app) { %>
                                    <tr id="appointment-row-<%= app.id %>" style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 12px;">
                                            <%= app.date %>
                                        </td>
                                        <td style="padding: 12px; font-weight: bold;">
                                            <%= app.name %>
                                        </td>
                                        <td style="padding: 12px;"><a href="tel:<%= app.phone %>">
                                                <%= app.phone %>
                                            </a></td>
                                        <td style="padding: 12px;">
                                            <%= app.service %>
                                        </td>
                                        <td style="padding: 12px;">
                                            <span class="status-badge <%= app.status %>"
                                                style="padding: 4px 8px; border-radius: 4px; background: #e3f2fd; color: #1976d2; font-size: 0.9em;">
                                                <%= app.status==='new' ? 'Новий' : app.status %>
                                            </span>
                                        </td>
                                        <td style="padding: 12px;">
                                            <button class="btn-icon" title="Видалити"
                                                onclick="deleteAppointment('<%= app.id %>')" style="color: #ff4444;"><i
                                                    class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" style="padding: 20px; text-align: center; color: #666;">
                                                    Поки що немає записів</td>
                                            </tr>
                                            <% } %>
