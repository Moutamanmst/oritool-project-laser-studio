                    style="background: #eee; color: #333; border: none;">Скасувати</button>
            </div>
        </div>
    </div>
    <!-- Debug Console -->
    <div id="debugConsole"
        style="position: fixed; bottom: 0; left: 0; width: 100%; height: 200px; background: #000; color: #0f0; font-family: monospace; font-size: 14px; padding: 15px; overflow-y: auto; z-index: 10000; border-top: 4px solid #f00; display: none;">
        <div><strong>Debug Console (System Status)</strong> <button
                onclick="document.getElementById('debugConsole').style.display='none'"
                style="float: right; padding: 5px 10px; background: #333; color: white; border: 1px solid #666;">Close</button>
        </div>
        <div id="debugLogContent"></div>
    </div>
    <button onclick="document.getElementById('debugConsole').style.display='block'"
        style="position: fixed; bottom: 10px; left: 10px; z-index: 9998; font-size: 10px; opacity: 0.5;">Debug</button>

    <script>
        function logDebug(msg) {
            const log = document.getElementById('debugLogContent');
            if (log) {
                const entry = document.createElement('div');
                entry.innerText = `[${new Date().toLocaleTimeString()}] ${msg}`;
                log.prepend(entry);
            }
            // console.log(msg); // Keep browser console logging as well
        }

        function openTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabName).classList.add('active');
            event.currentTarget.classList.add('active');
            logDebug(`Opened tab: ${tabName}`);
        }

        let cropper;
        let currentInput;
        let currentHiddenInputId;
        let currentPreviewId;

        function addPriceItem(btn, catIndex) {
            const container = btn.previousElementSibling;
            const itemIndex = container.children.length;
            const div = document.createElement('div');
            div.className = 'price-item-row';
            div.style = 'display: flex; gap: 10px; margin-bottom: 10px;';
            div.innerHTML = `
                <input type="text" name="prices[${catIndex}][items][${itemIndex}][name]" placeholder="Назва послуги" style="flex-grow: 2;">
                <input type="text" name="prices[${catIndex}][items][${itemIndex}][price]" placeholder="Ціна" style="flex-grow: 1;">
                <button type="button" class="delete-btn" onclick="this.closest('.price-item-row').remove()" style="width: auto; padding: 0 10px;">
                    <i class="fas fa-times"></i>
